# Inject secrets through your CI secret manager or process environment.
# SuperQ does not automatically load .env files.
SUPERQ_POSTGRES_URL=postgresql://readonly:replace-me@localhost:5432/app
SUPERQ_MONGO_URL=mongodb://readonly:replace-me@localhost:27017/app
SUPERQ_SNOWFLAKE_ACCOUNT=replace-me
SUPERQ_SNOWFLAKE_USER=replace-me
SUPERQ_SNOWFLAKE_PASSWORD=replace-me
SUPERQ_SNOWFLAKE_READ_ROLE=SUPERQ_READONLY
SUPERQ_SNOWFLAKE_WAREHOUSE=SUPERQ_XS
