              "expected": 200
            },
            {
              "path": "body.status",
              "operator": "equals",
              "expected": "ok"
            }
          ]
        }
      ],
      "tags": [
        "smoke",
        "api"
      ],
      "retrySafe": true,
      "covers": {
        "REQ-HEALTH": [
          "AC-HTTP",
          "AC-BODY"
        ]
