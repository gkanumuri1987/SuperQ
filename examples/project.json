      ],
      "evidenceIds": [
        "DOC-1"
      ],
      "suites": [
        "browser",
        "regression"
      ],
      "steps": [
        {
          "action": "health-page",
          "input": {
            "commands": [
              {
                "type": "goto",
                "path": "/"
              },
              {
                "type": "expectText",
                "locator": "health-status",
                "value": "Service healthy",
                "timeoutMs": 5000
              }
            ]
          },
          "assertions": [
            {
              "path": "text.health-status",
              "operator": "equals",
              "expected": "Service healthy"
            }
          ]
        }
      ],
      "tags": [
        "smoke",
        "web"
      ],
      "retrySafe": true,
      "covers": {
