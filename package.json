{
  "name": "superq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven quality engineering automation",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc && npm run build:studio",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm run typecheck && npm test",
    "superq": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts analyze examples/project.json",
    "bdd": "npm run build && cucumber-js --import examples/bdd/steps.mjs examples/bdd/health.feature",
    "reference-app": "tsx examples/server.ts",
    "verify-example": "tsx examples/verify.ts",
    "typecheck": "tsc -p tsconfig.check.json && npm run typecheck:studio",
    "studio": "tsx src/workspace-server.ts --dev",
    "studio:serve": "tsx src/workspace-server.ts",
    "build:studio": "vite build --config studio/vite.config.ts",
    "typecheck:studio": "tsc -p studio/tsconfig.json",
    "format:studio": "prettier --write studio src/maintenance.ts src/workspace-server.ts src/workspace/sample.ts tests/maintenance.test.ts tests/workspace.test.ts tests/studio.test.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.56.0",
    "lucide-react": "^1.59.0",
    "mongodb": "^6.20.0",
    "pg": "^8.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "snowflake-sdk": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/snowflake-sdk": "^1.6.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
